# Audiobookshelf connection
ABS_URL=http://your-abs-host:13378
ABS_TOKEN=your-api-token-here

# Path to your audiobook library on the Docker host
AUDIOBOOK_PATH=/path/to/your/audiobooks

# Naming template (optional — this is the default)
DEFAULT_TEMPLATE={author} - {title} ({year})

# UID/GID of the user that owns the audiobook files (for write permission)
UID=1000
GID=1000

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Optional password to protect the UI (leave empty to disable auth)
APP_PASSWORD=

# Path to the SQLite database file (default works inside Docker with named volume)
# DB_PATH=/data/shelf-renamer.db
